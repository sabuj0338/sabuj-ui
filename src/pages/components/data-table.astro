---
import * as UIDataTable from "@/components/ui/DataTable"
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import DocSidebar from "@/components/DocSidebar.astro"
import dataTableCode from "@/components/ui/DataTable.tsx?raw"
import {
  Copy,
  Database,
  Download,
  FileCode2,
  FileText,
  Terminal,
} from "lucide-react"

const component = {
  id: "data-table",
  name: "DataTable",
  status: "Ready",
  description:
    "A powerful, feature-rich data table component supporting selection, custom pagination, sorting, pinning, and localization.",
  file: "src/components/ui/DataTable.tsx",
  source: dataTableCode,
  exports: ["default (DataTable)", "DataTableProps"],
  dependencies: [
    "@tanstack/react-table",
    "lucide-react",
    "@/components/ui/table",
    "@/components/ui/paginator",
  ],
  props: [
    {
      name: "columns",
      type: "ColumnDef<TData, TValue>[]",
      defaultValue: "-",
      description: "The Column definitions from @tanstack/react-table.",
    },
    {
      name: "data",
      type: "TData[]",
      defaultValue: "-",
      description: "The array of records to display in the table.",
    },
    {
      name: "rowSelection",
      type: "RowSelectionState",
      defaultValue: "-",
      description: "State of selected rows in the table.",
    },
    {
      name: "onRowSelectionChange",
      type: "OnChangeFn<RowSelectionState>",
      defaultValue: "-",
      description: "Callback triggered when a row selection changes.",
    },
    {
      name: "pagination",
      type: "PaginatorProps",
      defaultValue: "-",
      description: "Optional properties passed to render the paginator footer.",
    },
    {
      name: "isLoading",
      type: "boolean",
      defaultValue: "false",
      description: "Shows a spin loader in the table body when true.",
    },
    {
      name: "sorting",
      type: "SortingState",
      defaultValue: "-",
      description: "The active sorting state of the table.",
    },
    {
      name: "setSorting",
      type: "(data: SortingState) => void",
      defaultValue: "-",
      description: "Callback to update sorting state.",
    },
    {
      name: "onRowClick",
      type: "(row: TData) => void",
      defaultValue: "-",
      description: "Callback triggered when clicking on a row.",
    },
    {
      name: "rowLink",
      type: "string",
      defaultValue: "-",
      description:
        "An optional template link (e.g. /users/_link_) that makes the row clickable.",
    },
    {
      name: "headerTopRounded",
      type: "boolean",
      defaultValue: "false",
      description: "Applies rounded borders to the top corners of the header.",
    },
    {
      name: "emptyComponent",
      type: "React.ReactNode",
      defaultValue: "-",
      description: "Custom UI component displayed when there is no data.",
    },
    {
      name: "locale",
      type: "string",
      defaultValue: "'en'",
      description: "Locale configuration ('en' | 'bn') for localized numbers.",
    },
    {
      name: "noDataFoundText",
      type: "string",
      defaultValue: "'No data found'",
      description: "Custom localized empty message.",
    },
    {
      name: "rowsSelectedText",
      type: "string",
      defaultValue: "'rows selected'",
      description: "Custom localized rows selection footer label.",
    },
    {
      name: "ofText",
      type: "string",
      defaultValue: "'of'",
      description: "Custom localized 'of' footer label.",
    },
  ],
}

const mockColumns = [
  {
    accessorKey: "status",
    header: "Status",
  },
  {
    accessorKey: "email",
    header: "Email",
  },
  {
    accessorKey: "amount",
    header: "Amount",
  },
]

const mockData = [
  { id: 1, status: "Success", email: "ken99@yahoo.com", amount: "$316.00" },
  { id: 2, status: "Success", email: "abe45@gmail.com", amount: "$242.00" },
  {
    id: 3,
    status: "Processing",
    email: "monserrat44@gmail.com",
    amount: "$837.50",
  },
]

const dataTableExample = String.raw`import DataTable from "@/components/ui/DataTable"

const columns = [
  { accessorKey: "status", header: "Status" },
  { accessorKey: "email", header: "Email" },
  { accessorKey: "amount", header: "Amount" }
]

const data = [
  { id: "1", status: "Success", email: "user@example.com", amount: "$100" }
]

export function TableDemo() {
  return (
    <DataTable
      columns={columns}
      data={data}
      headerTopRounded
      locale="en"
    />
  )
}`
---

<Layout
  title="DataTable Component - Sabuj UI"
  description="A premium collection of reusable, beautiful, and accessible React components built with Astro, Tailwind CSS, and shadcn/ui conventions."
  keywords="data table component, react table, tanstack table, shadcn table, tailwind table, localized table"
  type="article"
>
  <div class="min-h-screen bg-background text-foreground">
    <SiteHeader active="data-table" />

    <div
      id="components"
      class="mx-auto grid max-w-7xl gap-8 px-5 pt-24 lg:grid-cols-[17rem_minmax(0,1fr)] lg:px-8"
    >
      <DocSidebar active="data-table" />

      <main class="min-w-0">
        <section class="mb-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="inline-flex items-center rounded-md bg-primary/10 px-2 py-1 text-xs font-medium text-primary ring-1 ring-primary/20"
            >
              {component.status}
            </span>
            <code
              class="rounded-md bg-muted px-2 py-1 text-xs text-muted-foreground"
            >
              {component.file}
            </code>
          </div>
          <div class="space-y-3">
            <p class="text-sm font-medium text-primary">Component</p>
            <h1 class="text-4xl font-bold tracking-tight">{component.name}</h1>
            <p class="max-w-2xl text-base leading-7 text-muted-foreground">
              {component.description}
            </p>
          </div>
        </section>

        <section class="rounded-lg border bg-background shadow-sm">
          <div class="min-w-0 divide-y">
            <section id="preview" class="scroll-mt-24 p-5 md:p-6">
              <div
                class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
              >
                <div
                  class="inline-flex w-fit items-center rounded-md border bg-muted p-1 text-sm font-medium"
                  role="tablist"
                >
                  <button
                    type="button"
                    class="rounded-sm bg-background px-3 py-1.5 shadow-sm transition-all focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                    role="tab"
                    aria-selected="true"
                    data-tab-group="data-table"
                    data-tab-target="data-table-preview-content"
                  >
                    Preview
                  </button>
                  <button
                    type="button"
                    class="rounded-sm px-3 py-1.5 text-muted-foreground transition-all hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                    role="tab"
                    aria-selected="false"
                    data-tab-group="data-table"
                    data-tab-target="data-table-code-content"
                  >
                    Code
                  </button>
                </div>

                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="inline-flex h-8 items-center justify-center gap-2 rounded-md border bg-background px-3 text-xs font-medium transition-colors hover:bg-accent"
                    data-copy-target="data-table-source"
                  >
                    <Copy className="size-3.5" />
                    <span data-button-label>Copy</span>
                  </button>
                  <button
                    type="button"
                    class="inline-flex h-8 items-center justify-center gap-2 rounded-md border bg-background px-3 text-xs font-medium transition-colors hover:bg-accent"
                    data-download-target="data-table-source"
                    data-download-file="DataTable.tsx"
                  >
                    <Download className="size-3.5" />
                    <span data-button-label>Download</span>
                  </button>
                </div>
              </div>

              <div id="data-table-preview-content" role="tabpanel">
                <div class="overflow-hidden rounded-lg border bg-muted/20">
                  <div class="space-y-6 bg-background p-5 md:p-8">
                    <UIDataTable.default
                      columns={mockColumns}
                      data={mockData}
                      locale="en"
                      pagination={{
                        currentPage: 1,
                        totalPages: 3,
                        totalItems: 8,
                        pageSize: 3,
                        onPageChange: () => undefined,
                      }}
                    />
                  </div>
                </div>
              </div>

              <div id="data-table-code-content" role="tabpanel" class="hidden">
                <pre
                  class="max-h-152 overflow-auto rounded-lg border bg-zinc-950 p-4 text-sm leading-6 text-zinc-100"><code id="data-table-source">{component.source}</code></pre>
              </div>

              <div class="mt-6 rounded-lg border bg-muted/20 p-5 md:p-6">
                <div class="grid gap-6 sm:grid-cols-3">
                  <div>
                    <h3 class="mb-3 text-sm font-semibold">Exports</h3>
                    <div class="flex flex-wrap gap-2">
                      {
                        component.exports.map((item) => (
                          <code class="rounded-md border bg-background px-2 py-1 text-xs">
                            {item}
                          </code>
                        ))
                      }
                    </div>
                  </div>
                  <div>
                    <h3 class="mb-3 text-sm font-semibold">Dependencies</h3>
                    <div class="flex flex-wrap gap-2">
                      {
                        component.dependencies.map((item) => (
                          <div class="rounded-md border bg-background px-2 py-1 text-xs">
                            <code>{item}</code>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                  <div>
                    <h3 class="mb-3 text-sm font-semibold">Install notes</h3>
                    <p class="text-xs leading-5 text-muted-foreground">
                      Install <code>@tanstack/react-table</code> and ensure you have
                      local shadcn <code>table</code> and <code>paginator</code> primitives.
                    </p>
                  </div>
                </div>
              </div>
            </section>

            <section id="usage" class="scroll-mt-24 p-5 md:p-6">
              <div class="mb-4 flex items-center gap-2 text-sm font-semibold">
                <Terminal className="size-4 text-primary" />
                Usage
              </div>
              <pre
                class="overflow-auto rounded-lg border bg-muted p-4 text-sm leading-6"><code>{dataTableExample}</code></pre>
            </section>

            <section id="api" class="scroll-mt-24 p-5 md:p-6">
              <div class="mb-4 flex items-center gap-2 text-sm font-semibold">
                <FileCode2 className="size-4 text-primary" />
                API reference
              </div>
              <div class="overflow-x-auto rounded-lg border">
                <table class="w-full min-w-2xl text-left text-sm">
                  <thead
                    class="border-b bg-muted/60 text-xs text-muted-foreground"
                  >
                    <tr>
                      <th class="px-4 py-3 font-medium">Prop</th>
                      <th class="px-4 py-3 font-medium">Type</th>
                      <th class="px-4 py-3 font-medium">Default</th>
                      <th class="px-4 py-3 font-medium">Description</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y">
                    {
                      component.props.map((prop) => (
                        <tr>
                          <td class="px-4 py-3 align-top">
                            <code class="font-semibold">{prop.name}</code>
                          </td>
                          <td class="px-4 py-3 align-top text-muted-foreground">
                            <code>{prop.type}</code>
                          </td>
                          <td class="px-4 py-3 align-top text-muted-foreground">
                            <code>{prop.defaultValue}</code>
                          </td>
                          <td class="px-4 py-3 align-top leading-6">
                            {prop.description}
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </section>

            <section class="border-t px-6 py-10">
              <div
                class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
              >
                <div class="space-y-4">
                  <p class="text-sm font-medium text-primary">Pattern</p>
                  <h2 class="text-3xl font-semibold">
                    Highly Customizable Layouts
                  </h2>
                  <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
                    Connect it with standard react state or a server endpoint to
                    render large dynamic datasets efficiently.
                  </p>
                  <a
                    href={`${import.meta.env.BASE_URL}docs/component-documentation-guide/`}
                    class="inline-flex h-10 items-center justify-center gap-2 rounded-md border bg-background px-4 text-sm font-medium transition-colors hover:bg-accent"
                  >
                    <FileText className="size-4" />
                    Open guide file
                  </a>
                </div>

                <div class="rounded-lg border bg-background p-4 shadow-sm">
                  <div
                    class="mb-3 flex items-center gap-2 text-sm font-semibold"
                  >
                    <Database className="size-4 text-primary" />
                    Data views
                  </div>
                  <p class="text-sm leading-6 text-muted-foreground">
                    Optimized for rapid loading and consistent alignment under
                    modern glassmorphism dashboards.
                  </p>
                </div>
              </div>
            </section>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script>
    const copyButtons = document.querySelectorAll("[data-copy-target]")
    const downloadButtons = document.querySelectorAll("[data-download-target]")
    const tabButtons = document.querySelectorAll("[data-tab-target]")

    copyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const targetId = button.getAttribute("data-copy-target")
        const target = targetId ? document.getElementById(targetId) : null
        const code = target?.textContent ?? ""
        const label = button.querySelector("[data-button-label]")
        const originalText = label?.textContent ?? "Copy"

        await navigator.clipboard.writeText(code)
        if (label) label.textContent = "Copied"

        window.setTimeout(() => {
          if (label) label.textContent = originalText
        }, 1400)
      })
    })

    downloadButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const targetId = button.getAttribute("data-download-target")
        const fileName =
          button.getAttribute("data-download-file") ?? "component.tsx"
        const target = targetId ? document.getElementById(targetId) : null
        const code = target?.textContent ?? ""
        const blob = new Blob([code], { type: "text/plain;charset=utf-8" })
        const url = URL.createObjectURL(blob)
        const link = document.createElement("a")

        link.href = url
        link.download = fileName
        link.click()
        URL.revokeObjectURL(url)
      })
    })

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.getAttribute("data-tab-group")
        const targetId = button.getAttribute("data-tab-target")

        document
          .querySelectorAll(`[data-tab-group="${group}"]`)
          .forEach((btn) => {
            btn.setAttribute("aria-selected", "false")
            btn.classList.remove(
              "bg-background",
              "shadow-sm",
              "text-foreground"
            )
            btn.classList.add("text-muted-foreground")
          })

        button.setAttribute("aria-selected", "true")
        button.classList.add("bg-background", "shadow-sm", "text-foreground")
        button.classList.remove("text-muted-foreground")

        const section = button.closest("section")
        if (section) {
          section.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
            panel.classList.add("hidden")
          })
          const targetPanel = document.getElementById(targetId || "")
          if (targetPanel) {
            targetPanel.classList.remove("hidden")
          }
        }
      })
    })
  </script>
</Layout>
