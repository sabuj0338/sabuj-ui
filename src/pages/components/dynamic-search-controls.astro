---
import * as UIDynamicSearchControls from "@/components/ui/DynamicSearchControls"
import type { FieldConfig } from "@/components/ui/DynamicSearchControls"
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site-header.astro"
import DocSidebar from "@/components/DocSidebar.astro"
import dynamicSearchControlsCode from "@/components/ui/DynamicSearchControls.tsx?raw"
import {
  Copy,
  Database,
  Download,
  FileCode2,
  FileText,
  Terminal,
} from "lucide-react"

const component = {
  id: "dynamic-search-controls",
  name: "DynamicSearchControls",
  status: "Ready",
  description:
    "A generic filter and search component that automatically renders text inputs, date pickers, date ranges, and select boxes based on metadata.",
  file: "src/components/ui/DynamicSearchControls.tsx",
  source: dynamicSearchControlsCode,
  exports: [
    "default (DynamicSearchControls)",
    "FieldOption",
    "FieldConfig",
    "DynamicSearchControlsProps",
  ],
  dependencies: [
    "lucide-react",
    "date-fns",
    "react-day-picker",
    "@/components/ui/button",
    "@/components/ui/calendar",
    "@/components/ui/input",
    "@/components/ui/popover",
    "@/components/ui/select",
  ],
  props: [
    {
      name: "filters",
      type: "T",
      defaultValue: "-",
      description:
        "An object containing the current value of the filters (key-value pairs).",
    },
    {
      name: "fieldConfigs",
      type: "FieldConfig<T>[]",
      defaultValue: "-",
      description:
        "Configuration list defining keys, input types, options, placeholders, and styling for each filter field.",
    },
    {
      name: "onFilterInputChange",
      type: "(field: keyof T, value: string) => void",
      defaultValue: "-",
      description: "Callback triggered when any filter input changes.",
    },
    {
      name: "onSearch",
      type: "() => void",
      defaultValue: "-",
      description: "Callback triggered when the search button is clicked.",
    },
    {
      name: "onReset",
      type: "() => void",
      defaultValue: "-",
      description: "Callback triggered when the reset button is clicked.",
    },
    {
      name: "isResetDisabled",
      type: "boolean",
      defaultValue: "-",
      description: "Disables the reset button.",
    },
    {
      name: "isLoading",
      type: "boolean",
      defaultValue: "false",
      description: "Disables all controls during loading states.",
    },
    {
      name: "children",
      type: "React.ReactNode",
      defaultValue: "-",
      description:
        "Optional custom elements appended after the search actions.",
    },
    {
      name: "defaultInputClassName",
      type: "string",
      defaultValue: "'w-auto min-w-40 flex-1 md:flex-none'",
      description: "Default tailwind class list applied to input elements.",
    },
  ],
}

const mockFilters = {
  search: "",
  status: "",
}

type MockFilters = typeof mockFilters

const mockFieldConfigs: FieldConfig<MockFilters>[] = [
  {
    key: "search",
    label: "Keyword",
    inputType: "text" as const,
    placeholder: "Search keyword...",
  },
  {
    key: "status",
    label: "Status",
    inputType: "select" as const,
    options: [
      { value: "all", label: "All Statuses" },
      { value: "active", label: "Active" },
      { value: "completed", label: "Completed" },
    ],
  },
]

const searchControlsExample = String.raw`import DynamicSearchControls from "@/components/ui/DynamicSearchControls"

const fieldConfigs = [
  { key: "search", label: "Keyword", inputType: "text" },
  { key: "status", label: "Status", inputType: "select", options: [
      { value: "active", label: "Active" }
    ]
  }
]

export function SearchPanel() {
  const [filters, setFilters] = React.useState({ search: "", status: "" })

  return (
    <DynamicSearchControls
      filters={filters}
      fieldConfigs={fieldConfigs}
      onFilterInputChange={(key, val) => setFilters(prev => ({ ...prev, [key]: val }))}
      onSearch={() => console.log("Searching...", filters)}
      onReset={() => setFilters({ search: "", status: "" })}
      isResetDisabled={!filters.search && !filters.status}
    />
  )
}`
---

<Layout
  title="DynamicSearchControls Component - Sabuj UI"
  description="A premium collection of reusable, beautiful, and accessible React components built with Astro, Tailwind CSS, and shadcn/ui conventions."
  keywords="search controls, filter controls, dynamic search, shadcn search, tailwind filtering"
  type="article"
>
  <div class="min-h-screen bg-background text-foreground">
    <SiteHeader active="dynamic-search-controls" />

    <div
      id="components"
      class="mx-auto grid max-w-7xl gap-8 px-5 pt-24 lg:grid-cols-[17rem_minmax(0,1fr)] lg:px-8"
    >
      <DocSidebar active="dynamic-search-controls" />

      <main class="min-w-0">
        <section class="mb-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="inline-flex items-center rounded-md bg-primary/10 px-2 py-1 text-xs font-medium text-primary ring-1 ring-primary/20"
            >
              {component.status}
            </span>
            <code
              class="rounded-md bg-muted px-2 py-1 text-xs text-muted-foreground"
            >
              {component.file}
            </code>
          </div>
          <div class="space-y-3">
            <p class="text-sm font-medium text-primary">Component</p>
            <h1 class="text-4xl font-bold tracking-tight">{component.name}</h1>
            <p class="max-w-2xl text-base leading-7 text-muted-foreground">
              {component.description}
            </p>
          </div>
        </section>

        <section class="rounded-lg border bg-background shadow-sm">
          <div class="min-w-0 divide-y">
            <section id="preview" class="scroll-mt-24 p-5 md:p-6">
              <div
                class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
              >
                <div
                  class="inline-flex w-fit items-center rounded-md border bg-muted p-1 text-sm font-medium"
                  role="tablist"
                >
                  <button
                    type="button"
                    class="rounded-sm bg-background px-3 py-1.5 shadow-sm transition-all focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                    role="tab"
                    aria-selected="true"
                    data-tab-group="dynamic-search"
                    data-tab-target="dynamic-search-preview-content"
                  >
                    Preview
                  </button>
                  <button
                    type="button"
                    class="rounded-sm px-3 py-1.5 text-muted-foreground transition-all hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                    role="tab"
                    aria-selected="false"
                    data-tab-group="dynamic-search"
                    data-tab-target="dynamic-search-code-content"
                  >
                    Code
                  </button>
                </div>

                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="inline-flex h-8 items-center justify-center gap-2 rounded-md border bg-background px-3 text-xs font-medium transition-colors hover:bg-accent"
                    data-copy-target="dynamic-search-source"
                  >
                    <Copy className="size-3.5" />
                    <span data-button-label>Copy</span>
                  </button>
                  <button
                    type="button"
                    class="inline-flex h-8 items-center justify-center gap-2 rounded-md border bg-background px-3 text-xs font-medium transition-colors hover:bg-accent"
                    data-download-target="dynamic-search-source"
                    data-download-file="DynamicSearchControls.tsx"
                  >
                    <Download className="size-3.5" />
                    <span data-button-label>Download</span>
                  </button>
                </div>
              </div>

              <div id="dynamic-search-preview-content" role="tabpanel">
                <div class="overflow-hidden rounded-lg border bg-muted/20">
                  <div
                    class="flex flex-wrap items-center gap-3 bg-background p-5 md:p-8"
                  >
                    <UIDynamicSearchControls.default
                      filters={mockFilters}
                      fieldConfigs={mockFieldConfigs}
                      onFilterInputChange={() => undefined}
                      onSearch={() => undefined}
                      onReset={() => undefined}
                      isResetDisabled={false}
                    />
                  </div>
                </div>
              </div>

              <div
                id="dynamic-search-code-content"
                role="tabpanel"
                class="hidden"
              >
                <pre
                  class="max-h-152 overflow-auto rounded-lg border bg-zinc-950 p-4 text-sm leading-6 text-zinc-100"><code id="dynamic-search-source">{component.source}</code></pre>
              </div>

              <div class="mt-6 rounded-lg border bg-muted/20 p-5 md:p-6">
                <div class="grid gap-6 sm:grid-cols-3">
                  <div>
                    <h3 class="mb-3 text-sm font-semibold">Exports</h3>
                    <div class="flex flex-wrap gap-2">
                      {
                        component.exports.map((item) => (
                          <code class="rounded-md border bg-background px-2 py-1 text-xs">
                            {item}
                          </code>
                        ))
                      }
                    </div>
                  </div>
                  <div>
                    <h3 class="mb-3 text-sm font-semibold">Dependencies</h3>
                    <div class="flex flex-wrap gap-2">
                      {
                        component.dependencies.map((item) => (
                          <div class="rounded-md border bg-background px-2 py-1 text-xs">
                            <code>{item}</code>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                  <div>
                    <h3 class="mb-3 text-sm font-semibold">Install notes</h3>
                    <p class="text-xs leading-5 text-muted-foreground">
                      Relies on date-fns, react-day-picker, and local shadcn
                      components (button, calendar, input, popover, select).
                    </p>
                  </div>
                </div>
              </div>
            </section>

            <section id="usage" class="scroll-mt-24 p-5 md:p-6">
              <div class="mb-4 flex items-center gap-2 text-sm font-semibold">
                <Terminal className="size-4 text-primary" />
                Usage
              </div>
              <pre
                class="overflow-auto rounded-lg border bg-muted p-4 text-sm leading-6"><code>{searchControlsExample}</code></pre>
            </section>

            <section id="api" class="scroll-mt-24 p-5 md:p-6">
              <div class="mb-4 flex items-center gap-2 text-sm font-semibold">
                <FileCode2 className="size-4 text-primary" />
                API reference
              </div>
              <div class="overflow-x-auto rounded-lg border">
                <table class="w-full min-w-2xl text-left text-sm">
                  <thead
                    class="border-b bg-muted/60 text-xs text-muted-foreground"
                  >
                    <tr>
                      <th class="px-4 py-3 font-medium">Prop</th>
                      <th class="px-4 py-3 font-medium">Type</th>
                      <th class="px-4 py-3 font-medium">Default</th>
                      <th class="px-4 py-3 font-medium">Description</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y">
                    {
                      component.props.map((prop) => (
                        <tr>
                          <td class="px-4 py-3 align-top">
                            <code class="font-semibold">{prop.name}</code>
                          </td>
                          <td class="px-4 py-3 align-top text-muted-foreground">
                            <code>{prop.type}</code>
                          </td>
                          <td class="px-4 py-3 align-top text-muted-foreground">
                            <code>{prop.defaultValue}</code>
                          </td>
                          <td class="px-4 py-3 align-top leading-6">
                            {prop.description}
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </section>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script>
    const copyButtons = document.querySelectorAll("[data-copy-target]")
    const downloadButtons = document.querySelectorAll("[data-download-target]")
    const tabButtons = document.querySelectorAll("[data-tab-target]")

    copyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const targetId = button.getAttribute("data-copy-target")
        const target = targetId ? document.getElementById(targetId) : null
        const code = target?.textContent ?? ""
        const label = button.querySelector("[data-button-label]")
        const originalText = label?.textContent ?? "Copy"

        await navigator.clipboard.writeText(code)
        if (label) label.textContent = "Copied"

        window.setTimeout(() => {
          if (label) label.textContent = originalText
        }, 1400)
      })
    })

    downloadButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const targetId = button.getAttribute("data-download-target")
        const fileName =
          button.getAttribute("data-download-file") ?? "component.tsx"
        const target = targetId ? document.getElementById(targetId) : null
        const code = target?.textContent ?? ""
        const blob = new Blob([code], { type: "text/plain;charset=utf-8" })
        const url = URL.createObjectURL(blob)
        const link = document.createElement("a")

        link.href = url
        link.download = fileName
        link.click()
        URL.revokeObjectURL(url)
      })
    })

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.getAttribute("data-tab-group")
        const targetId = button.getAttribute("data-tab-target")

        document
          .querySelectorAll(`[data-tab-group="${group}"]`)
          .forEach((btn) => {
            btn.setAttribute("aria-selected", "false")
            btn.classList.remove(
              "bg-background",
              "shadow-sm",
              "text-foreground"
            )
            btn.classList.add("text-muted-foreground")
          })

        button.setAttribute("aria-selected", "true")
        button.classList.add("bg-background", "shadow-sm", "text-foreground")
        button.classList.remove("text-muted-foreground")

        const section = button.closest("section")
        if (section) {
          section.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
            panel.classList.add("hidden")
          })
          const targetPanel = document.getElementById(targetId || "")
          if (targetPanel) {
            targetPanel.classList.remove("hidden")
          }
        }
      })
    })
  </script>
</Layout>
